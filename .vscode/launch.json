{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug InfiniteLLM Gateway",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/main.go",
            "envFile": "${workspaceFolder}/.env",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Test Current Function",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${fileDirname}",
            "args": [
                "-test.v",
                "-test.run",
                "^${selectedText}$"
            ],
            "envFile": "${workspaceFolder}/.env",
            "showLog": true
        }
    ]
}